generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id                    String                  @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  email                 String                  @unique
  password              String?
  role                  Role                    @default(USER)
  image                 String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  accounts              Account[]
  sessions              Session[]
  uploadedImages        UploadedImage[]
  identificationHistory IdentificationHistory[]
  activityLogs          ActivityLog[]
}

model CoconutVariety {
  id                    String                  @id @default(auto()) @map("_id") @db.ObjectId
  name                  String                  @unique
  scientificName        String?
  localName             String?
  description           String
  characteristics       String
  treeHeight            String
  fruitColor            String
  averageYield          String
  locationFound         String
  imageUrl              String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  identificationHistory IdentificationHistory[]
}

model UploadedImage {
  id                    String                   @id @default(auto()) @map("_id") @db.ObjectId
  url                   String
  publicId              String?
  fileName              String
  mimeType              String
  userId                String?                  @db.ObjectId
  createdAt             DateTime                 @default(now())
  user                  User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  identificationHistory IdentificationHistory?
}

model IdentificationHistory {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  confidence       Float
  notes            String?
  userId           String?         @db.ObjectId
  uploadedImageId  String?         @unique @db.ObjectId
  coconutVarietyId String?         @db.ObjectId
  createdAt        DateTime        @default(now())
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  uploadedImage    UploadedImage?  @relation(fields: [uploadedImageId], references: [id], onDelete: SetNull)
  coconutVariety   CoconutVariety? @relation(fields: [coconutVarietyId], references: [id], onDelete: SetNull)
}

model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  entity    String
  entityId  String?
  userId    String?  @db.ObjectId
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
